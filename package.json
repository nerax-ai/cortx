{
  "name": "cortx",
  "private": true,
  "workspaces": [
    "packages/*",
    "../nerax/packages/logger",
    "../nerax/packages/plugin",
    "../nerax/packages/storage",
    "../synax/packages/core",
    "../synax/packages/sdk"
  ],
  "scripts": {
    "build": "bun run --filter '@cortx/*' build",
    "dev": "bun run --filter '@cortx/*' dev",
    "lint": "bun run --filter '@cortx/*' lint",
    "test": "bun test",
    "typecheck:tui-tests": "bun run --cwd packages/tui tsc --project tsconfig.test.json --noEmit",
    "test:plugin": "bun test packages/runtime/tests/plugin-foundation.test.ts packages/runtime/tests/plugin-admin.test.ts packages/server/tests/security.test.ts packages/server/tests/u8-server.test.ts packages/tui/src/__tests__/tui-host.test.ts packages/tui/src/__tests__/remote-sse.test.ts",
    "test:product-dogfood": "bun test tests/product-dogfood-smoke.test.ts",
    "test:lockfile": "bun --no-env-file install --frozen-lockfile --ignore-scripts",
    "test:package": "bun run test:lockfile && bun run build && bun scripts/test-package.ts",
    "clean": "bun run --filter '@cortx/*' clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "bun-types": "^1.3.9",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
