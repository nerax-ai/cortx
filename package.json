{
  "name": "cortx",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "lint": "bun run --filter '*' lint",
    "test": "bun test",
    "clean": "bun run --filter '*' clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "bun-types": "^1.3.9",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@nerax-ai/logger": "file:../nerax/packages/logger",
    "@nerax-ai/plugin": "file:../nerax/packages/plugin",
    "@nerax-ai/storage": "file:../nerax/packages/storage"
  }
}
