{
  "name": "@cortx/tui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cortx": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "start": "bun src/cli.tsx"
  },
  "dependencies": {
    "@cortx/code": "workspace:*",
    "@cortx/core": "workspace:*",
    "@cortx/sdk": "workspace:*",
    "@cortx/store": "workspace:*",
    "@nerax-ai/logger": "link:@nerax-ai/logger",
    "@nerax-ai/plugin": "link:@nerax-ai/plugin",
    "@nerax-ai/storage": "link:@nerax-ai/storage",
    "@synax-ai/core": "link:@synax-ai/core",
    "@synax-ai/sdk": "link:@synax-ai/sdk",
    "cli-highlight": "^2.1.11",
    "ink": "^7.0.1",
    "react": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0"
  }
}
