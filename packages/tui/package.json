{
  "name": "@cortx/tui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "cortx": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "start": "bun src/cli.tsx"
  },
  "dependencies": {
    "@cortx/runtime": "workspace:*",
    "@cortx/sdk": "workspace:*",
    "@cortx/store": "workspace:*",
    "@nerax-ai/logger": "^0.2.0",
    "@nerax-ai/plugin": "^0.2.0",
    "@nerax-ai/storage": "^0.2.0",
    "@synax-ai/core": "^0.1.0",
    "@synax-ai/sdk": "^0.1.0",
    "cli-highlight": "^2.1.11",
    "ink": "^7.1.0",
    "react": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0"
  }
}
