{
  "name": "@cortx/server",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "start": "bun src/bin.ts"
  },
  "dependencies": {
    "@cortx/core": "workspace:*",
    "@cortx/sdk": "workspace:*",
    "@cortx/store": "workspace:*",
    "@nerax-ai/plugin": "link:@nerax-ai/plugin",
    "@nerax-ai/storage": "file:../../../nerax/packages/storage",
    "@synax-ai/core": "link:@synax-ai/core",
    "@synax-ai/sdk": "link:@synax-ai/sdk",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.9"
  }
}
