{
  "name": "@cortx/sdk",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "type-test": "tsc --project tsconfig.type-test.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nerax-ai/logger": "^0.2.0",
    "@nerax-ai/plugin": "^0.2.0",
    "@synax-ai/sdk": "link:@synax-ai/sdk"
  }
}
